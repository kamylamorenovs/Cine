<%- include('partials/cabecera', { titulo }) %>
<h1>Reservaciones</h1>
<% if (reservaciones.length === 0) { %>
  <p>No hay reservaciones. Agrégalas con POST /reservaciones/create.</p>
<% } else { %>
<table>
  <tr><th>ID</th><th>Cliente</th><th>Función (id)</th><th>Entradas</th></tr>
  <% reservaciones.forEach((r) => { %>
  <tr>
    <td><%= r.id %></td><td><%= r.cliente %></td><td>#<%= r.funcionId %></td><td><%= r.cantidad %></td>
  </tr>
  <% }) %>
</table>
<% } %>
<%- include('partials/pie') %>
